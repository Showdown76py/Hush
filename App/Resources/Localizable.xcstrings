    "Play some music on your speakers, press Start, and keep talking for 10 seconds.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez de la musique sur vos haut-parleurs, appuyez sur Démarrer et parlez pendant 10 secondes."
          }
        }
      }
    },
    "Plug in a microphone or check that your Mac’s built-in microphone is enabled.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez un micro ou vérifiez que le micro intégré de votre Mac est activé."
