      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro"
          }
        }
      }
    },
    "Microphone access was refused. Turn on Hush in System Settings › Privacy & Security › Microphone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro a été refusé. Activez Hush dans Réglages Système › Confidentialité et sécurité › Micro."
