    "Active": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif"
          }
        }
      }
    },
    "Active — %lld app(s) listening": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Active — %lld app listening"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Active — %lld apps listening"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Actif — %lld app à l’écoute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Actif — %lld apps à l’écoute"
                }
              }
            }
          }
        }
      }
    },
    "Allow Hush in System Settings › Privacy & Security › Microphone. If it’s already on, turn it off and on again, then reopen Hush.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Hush dans Réglages Système › Confidentialité et sécurité › Micro. S’il est déjà activé, désactivez-le puis réactivez-le, et rouvrez Hush."
          }
        }
      }
    },
    "Allow microphone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le micro"
          }
        }
      }
    },
    "Allow the microphone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le micro"
          }
        }
      }
    },
    "Always on": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours actif"
          }
        }
      }
    },
    "Another app may be using the microphone in an exclusive way. Hush will retry automatically.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise peut-être le micro en exclusivité. Hush va réessayer tout seul."
          }
        }
      }
    },
    "Apps get your normal microphone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps reçoivent votre micro normal"
          }
        }
      }
    },
    "Apps using “Hush Microphone” will lose their microphone. macOS will ask for your password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui utilisent « Hush Microphone » perdront leur micro. macOS vous demandera votre mot de passe."
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Automatic (recommended)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique (recommandé)"
          }
        }
      }
    },
    "Automatic (system default)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique (micro par défaut)"
          }
        }
      }
    },
    "Automatic Gain Control": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle automatique du gain"
          }
        }
      }
    },
    "Automatic adjusts to your voice only while you speak, so background noise is never boosted. macOS always lowers other sounds a little (about 8 dB) while voice cleanup runs; turn the last option on to use Apple’s stronger default instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En automatique, le niveau s’adapte à votre voix uniquement pendant que vous parlez : le bruit de fond n’est jamais amplifié. macOS baisse toujours un peu les autres sons (environ 8 dB) pendant le nettoyage de la voix ; activez la dernière option pour utiliser la baisse plus forte d’Apple."
          }
        }
      }
    },
    "Automatic — only when an app uses it": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique — seulement quand une app l’utilise"
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier à nouveau"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des mises à jour…"
          }
        }
      }
    },
    "Clean microphone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micro propre"
          }
        }
      }
    },
    "Clean microphone off": {
      "localizations": {
        "fr": {
          "stringUnit": {
