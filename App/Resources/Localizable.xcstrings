    },
    "Last step: choose Hush in Discord": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière étape : choisissez Hush dans Discord"
          }
        }
      }
    },
    "Lower other sounds while Hush is on": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisser les autres sons quand Hush est actif"
          }
        }
      }
    },
    "Make sure you entered an administrator password, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que vous avez saisi un mot de passe administrateur, puis réessayez."
          }
        }
      }
    },
